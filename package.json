{
  "name": "datavakwerk-nl",
  "version": "1.0.0",
  "private": true,
  "description": "Website van Datavakwerk — freelance business- en data-analist voor de publieke sector.",
  "homepage": "https://datavakwerk.nl",
  "license": "UNLICENSED",
  "author": "Ruud Juffermans <datavakwerk@ruudjuffermans.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datavakwerk/datavakwerk.nl.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "verify": "node scripts/verify-build.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
